# PepPred public SIF runtime configuration.
# Copy or source these values in a job script; do not edit tracked source files.
#
# Change note (2026-06-14, wyattb/codex):
# Public-SIF prep: document the supported env-var surface for SIF,
# external NetMHCpan, optional Rosetta, companion assets, and Slurm resources.
#
# Typical wrapper use:
#   cp peppred-public.env.example peppred-public.env
#   # Edit peppred-public.env for your cluster paths.
#   ./run_peppred.sh --env peppred-public.env --input input.csv --run-id my_run

# Required: absolute path to this repository on the host.
export PEPPRED_ROOT=/path/to/peppred

# Required for host-side Slurm orchestration.
export PEPPRED_SIF=/path/to/peppred-v0.1.0.sif

# Required: user-provided NetMHCpan install. Bind the host parent directory to
# the container directory below. Depending on which version you are using and
# your installation location these paths will change. If using 4.1 leave PEPPRED_NETMHCPAN_VERSION_DIR empty
export PEPPRED_NETMHCPAN_HOST_DIR=/path/to/netmhcpan
export PEPPRED_NETMHCPAN_CONTAINER_DIR=/opt/peppred/external/netmhcpan
export PEPPRED_NETMHCPAN_VERSION_DIR=netMHCpan-4.2-linux
export PEPPRED_NETMHCPAN_BINARY_NAME=netMHCpan

# Required only when PyRosetta is enabled. PyRosetta is attempted by default.
# PEPPRED_PYROSETTA_PATH must be a Python-version-compatible directory containing
# the pyrosetta package or its parent site-packages directory. Set
# PEPPRED_ENABLE_PYROSETTA=0 to use the Biopython fallback instead. For SIF runs,
# set HOST/CONTAINER paths if the package is not already under a bound directory
# such as PEPPRED_ROOT or SCRATCH.
export PEPPRED_ENABLE_PYROSETTA=1
export PEPPRED_PYROSETTA_HOST_PATH=
export PEPPRED_PYROSETTA_CONTAINER_PATH=
export PEPPRED_PYROSETTA_PATH=

# Companion model/tool asset bundle. Extract peppred-model-assets-v0.1.0.tar.zst
# on the host, then bind that directory to the matching container path.
export PEPPRED_ASSETS_HOST=/path/to/peppred-model-assets-v0.1.0
export PEPPRED_ASSETS_CONTAINER=/scratch/peppred-model-assets-v0.1.0
export PEPPRED_MODEL_PARAMS_HOST="${PEPPRED_ASSETS_HOST}/model_params"
export PEPPRED_MODEL_PARAMS_CONTAINER="${PEPPRED_ASSETS_CONTAINER}/model_params"
export PEPPRED_AFFT_PARAMS="${PEPPRED_ASSETS_CONTAINER}/AFFT-HLA3DB/params/7WKJ_af_mhc_params_2351.pkl"
export PEPPRED_INFERENCE_MODEL_BUNDLE="${PEPPRED_ASSETS_CONTAINER}/Inference/peppred.pkl"
export FOLDSEEK_BIN="${PEPPRED_ASSETS_CONTAINER}/tools/foldseek/bin/foldseek"

# Slurm resources. Rename partitions/constraints for your cluster. The v0.1.0
# SIF is validated on NVIDIA A100/compute capability 8.x. On Sherlock, use
# PEPPRED_GPU_CONSTRAINT=GPU_CC:8.0. H100/compute capability 9.x requires an
# updated image with compatible TensorFlow/JAX GPU builds.
export PEPPRED_CPU_PARTITION=normal
export PEPPRED_DRIVER_PARTITION="${PEPPRED_CPU_PARTITION}"
export PEPPRED_GPU_PARTITION=gpu
export PEPPRED_GPU_GRES=gpu:1
export PEPPRED_GPU_CONSTRAINT=
export PEPPRED_AFFT_TIME=01:00:00
export PEPPRED_AFFT_MEM=64G

# Default settings.
export ALPHAFOLD_ENV_CONTAINER=/opt/conda/envs/alphafold
export ALPHAFOLD_PYTHON_CONTAINER=/opt/conda/envs/alphafold/bin/python
export NUM_SAMPLES=2
export NUM_MPNN_SEQS=0
# Optional reproducibility knob for Protpardelle sampling. Leave empty to use
# Protpardelle defaults.
export PEPPRED_PROTPARDELLE_SEED=
# Optional Protpardelle output root override. Leave empty to keep each run's
# sampling outputs under protpardelle/results/<run-id>.
export PEPPRED_PROTPARDELLE_OUTPUT_DIR=
