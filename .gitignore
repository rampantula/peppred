# Change note (2026-06-14, wyattb/codex):
# Public-SIF release prep: keep generated validation outputs, caches, packaged
# assets, and local env files out of the PR while preserving source files.

# Python/runtime caches
__pycache__/
*.py[cod]
.pytest_cache/

# macOS metadata
.DS_Store
._*
__MACOSX/

# PepPred generated run state
results/
slurm_logs/
*.out
*.err
*.log
*.bak
peppred-public.env
release_assets/
peppred-model-assets-*.tar.zst
peppred-model-assets-*.tar.zst.sha256
peppred-model-assets-*.MANIFEST.sha256

